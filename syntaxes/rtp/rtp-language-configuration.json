{
  "comments": {
    "lineComment": ";"
  },
  "brackets": [
    ["[", "]"]
  ],
  "autoClosingPairs": [
    ["[", "]"]
  ],
  "surroundingPairs": [
    ["[", "]"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*\\[\\s*[A-Za-z0-9]+\\s*\\]",
      "end": "^\\s*\\[\\s*[A-Za-z0-9]+\\s*\\]"
    }
  }
}
