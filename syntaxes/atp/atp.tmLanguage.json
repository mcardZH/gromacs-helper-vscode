{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GROMACS Atom Types",
  "scopeName": "source.atp",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#atomtype-definition"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.semicolon.atp",
          "match": ";.*$"
        },
        {
          "name": "comment.line.asterisk.atp",
          "match": "^\\s*\\*.*$"
        }
      ]
    },
    "atomtype-definition": {
      "patterns": [
        {
          "match": "^\\s*([A-Za-z][A-Za-z0-9_]*)\\s+(\\d+\\.\\d+)",
          "captures": {
            "1": {
              "name": "entity.name.type.atomtype.atp"
            },
            "2": {
              "name": "constant.numeric.mass.atp"
            }
          }
        }
      ]
    }
  }
}
